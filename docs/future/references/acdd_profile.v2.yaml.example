# =============================================================================
# UNIFIED HIERARCHICAL ACDD PROFILE SPECIFICATION (v2)
# Future proposal, not accepted by the current runtime parser.
# Use acdd_profile.current.yaml.example for the executable current schema.
#
# Core Architectural Principles:
# 1. Everything is a Gate (`gates:`):
#    - Agent Gate:   has `role: <id>`    -> Claimed by LLM agent via `task claim`.
#    - Command Gate: has `command: <cmd>` -> Executed autonomously by engine (0 tokens).
#    - Container:    has `gates: [...]`  -> Nests child gates (e.g. per-task execution).
# 2. Unified Persistence Policy (`persistence:`):
#    Decouples snapshots, commits, and immutability from rigid stage types.
#    - `pre: snapshot | commit` (omitted = none) -> Captured automatically before changes (on claim).
#    - `post: snapshot | commit` (omitted = none) -> Captured/committed on stage pass.
#    - `immutable: true` (default false) -> Prohibits working tree deviation from prior snapshot.
#    - `restore_on_reject: true` (default false) -> Restores tree to pre-snapshot on rejection.
#    - `git_commit_note: command.<id> | GitCommitNotePolicy` -> Attaches compact, structured output of configured command to `refs/notes/forge` on commit.
#      Pure structured data (e.g. benchmark numbers) - not a warehouse for duplicate metadata (zero task_id, zero receipt_id).
#      Bounded by `git_commit_note.limits.max_bytes` (default 2048 bytes / 2 KiB) to prevent Git object bloat.
#    - On-demand tool safety net: `task_manage(action: "snapshot", name: "...")` and
#      `task_manage(action: "rollback", name: "...")` allow agents to create manual restore points.
# 3. Payload Overflow Guard & Resource Budgets (`limits:`):
#    - Enforces a 2 KiB hard default limit (`max_metadata_bytes: 2048`) on custom metrics, task notes,
#      and attached payloads to prevent SQLite, MCP response token, and Git object bloat.
# 4. Architect-Driven DAG Optimization & Cross-Milestone Linkage:
#    - The synthesis agent analyzes codebase impact radius (`code_map_impact`) and reshuffles
#      tasks into topological parallel execution waves (Wave 0 upfront contracts, Wave 1 disjoint
#      parallel tasks, Wave 2 integration/consumers).
#    - Milestones declare coordination contours via `linked_to: [milestones...]`.
#    - Tasks declare fine-grained cross-milestone blockers via `task_depends_on: [milestone:task_slug]`.
# 5. Zero-Argument Transitions (`task submit`):
#    Forge automatically compiles proof from SQLite execution trace and Git status.
# 6. Two-Tier Scope Governance with Manifest Synchronization:
#    - `scope`: Initial immutable baseline scope from milestone manifest.
#    - `extended_scope`: Mid-flight additions added via `task extend-scope <task_id> <path> --reason "..."`
#      or MCP `task_manage(action: "extend_scope", task_id: "...", path: "...", reason: "...")`.
#      The command atomically writes to both SQLite and the milestone markdown manifest!
#    - `review` gate enforces mandatory review proof verification of all extended_scope entries.
# 7. Unified Breadcrumbs & SQLite Checkpoints:
#    - Checkpoints are persisted in SQLite `gate_checkpoints`, keyed by the turn breadcrumb:
#      `{milestone_id}/{gate_path}/{task_id}/{stage_id}`.
# 8. Milestone Handoff State Purging:
#    - `handoff` gate automatically purges archived tasks, temporary blackboard noise,
#      gate execution traces, and ephemeral signals from active SQLite tables.
# =============================================================================

version: 2

# =============================================================================
# DEFAULT GUIDANCE SLOTS
# Gates declare parameterized slots (e.g. hitl); milestone frontmatter binds
# them (e.g. guidance: { hitl: hitl.pro }). If unbound, profile defaults apply.
# =============================================================================
guidance_slots:
  hitl: hitl.pro

# =============================================================================
# 0. GIT COMMIT NOTE & RESOURCE BUDGETS
# =============================================================================
git_commit_note:
  limits:
    max_bytes: 2048              # 2 KiB hard limit for Git commit notes attached to refs/notes/forge
  telemetry:
    # Telemetry passports are generated automatically by Forge on task delivery and milestone handoff.
    # No manual agent flags needed.
    format: markdown
    sections:
      - duration: true           # Total elapsed time (started_at -> completed_at)
      - tasks_summary: true      # Completed tasks count and per-task durations (e.g. task-1: 15m)
      - review_cycles: true      # Iterations, turns, and review rejections count
      - diff_breakdown: true     # Line additions/deletions categorized by src, tests, docs
      - ast_delta: true          # Net change in AST symbols (functions, structs, traits)
      - test_suite: true         # Test counts passed/failed and generic linter status (clean / warnings)
      - topology: true           # Upstream blockers resolved and downstream dependents unblocked

limits:
  max_metadata_bytes: 2048       # 2 KiB hard payload limit for arbitrary task/gate metadata & metrics
  max_trace_summary_bytes: 2048  # Tail output size for gate_execution_traces snippet in SQLite (INV-PAYLOAD-OVERFLOW-GUARD)

# =============================================================================
# 1. PROOFS CATALOG (`proofs`)
# Declarative proof schemas. The engine collects runtime evidence envelopes
# into SQLite (traces, test lists, diffs) and compiles zero-argument proofs.
# =============================================================================
proofs:
  contract:
    description: "Proof of runtime assertion failure (exit 101/1/134) proving red seam baseline"
    schema:
      type: object
      required: [exit_code, stderr]
      properties:
        exit_code: { type: integer }
        stderr: { type: string }
        contract_test_ref: { type: string }

  command:
    description: "Autonomous command execution proof (exit code 0, passed linters/tests)"
    schema:
      type: object
      required: [exit_code]
      properties:
        exit_code: { type: integer, const: 0 }
        tests_passed: { type: integer }
        tests_failed: { type: integer, const: 0 }

  review:
    description: "Independent cognitive review sign-off across focus lenses"
    schema:
      type: object
      required: [verdict, reviewer, contours_reviewed]
      properties:
        verdict: { type: string, enum: ["approved", "rejected"] }
        reviewer: { type: string }
        contours_reviewed: { type: array, items: { type: string } }
        extended_scope_review:
          type: object
          properties:
            approved_paths: { type: array, items: { type: string } }
            reason_verified: { type: boolean }
        notes: { type: string }

  seam_test:
    description: "Joint seam integration proof verifying all referenced cross-task tests passed"
    schema:
      type: object
      required: [exit_code, seam_test_refs]
      properties:
        exit_code: { type: integer, const: 0 }
        seam_test_refs: { type: array, items: { type: string } }
        tests_passed: { type: integer }
        tests_failed: { type: integer, const: 0 }

  delivery:
    description: "Autonomous delivery receipt and atomic Git commit proof"
    schema:
      type: object
      required: [commit_sha, receipt_id]
      properties:
        commit_sha: { type: string }
        receipt_id: { type: string }

# =============================================================================
# 2. ROLES CATALOG (`roles`)
# =============================================================================
roles:
  architect:
    mode: subagent
    reuse_on_reject: true
    models:
      - 'gpt-6.1-sol:xhigh'
      - 'claude-opus-5.5'

  builder:
    mode: subagent
    reuse_on_reject: true
    models:
      - 'gpt-6.1-sol:medium'
      - 'claude-opus-5.5'

  reviewer:
    mode: subagent
    reuse_on_reject: true
    models:
      - 'gpt-6.1-sol:xhigh'
      - 'claude-opus-5.5'

  doc_writer:
    mode: subagent
    reuse_on_reject: false
    models:
      - 'gpt-6.1-sol:medium'

# =============================================================================
# 2. COMMANDS CATALOG (`commands`)
# =============================================================================
commands:
  check_task:
    # Pattern-based multi-language dispatch based on task scope files:
    # Evaluates task scope against glob patterns. If matching files exist, executes the command.
    # If a task touches multiple languages (e.g. .py and .ts), executes matching commands sequentially.
    by_pattern:
      "**/*.py": "basedpyright {scope_target} && pytest {scope_target}"
      "**/*.{ts,tsx,vue}": "npm run typecheck && npm test -- {scope_target}"
      "**/*.rs": "cargo clippy --lib --test {scope_target} && cargo test --test {scope_target} -- --nocapture"
    timeout_seconds: 60

  check_full_repo:
    by_pattern:
      "**/*.py": "pytest"
      "**/*.{ts,tsx,vue}": "npm test"
      "**/*.rs": "cargo clippy --all-targets --all-features -- -D warnings && cargo test --all-targets"
    timeout_seconds: 600

  verify_migration:
    # Verifies database migrations and rollback safety (e.g. Django in traverse-commerce or SQLite in forge)
    by_pattern:
      "**/migrations/*.py": "python manage.py makemigrations --check --dry-run && pytest tests/test_migrations.py"
      "src/db/tasks_store/migrations/**": "cargo test --test acdd tasks::task_store_migration"
    timeout_seconds: 60

  benchmark:
    # Language-agnostic benchmark command emitting structured metrics
    by_pattern:
      "**/*.py": "pytest benchmarks/ --benchmark-json"
      "**/*.{ts,tsx}": "npm run bench -- --json"
      "**/*.rs": "cargo bench -- --output-format bencher"
    timeout_seconds: 120

# =============================================================================
# 3. UNIFIED GUIDANCE CATALOG (`guidance`)
# =============================================================================
guidance:
  milestone.synthesis: >
    Analyze requirements and impact radius across ALL milestone tasks.
    Optimize the DAG into topological parallel waves (Wave 0 upfront contracts, Wave 1 disjoint parallel tasks).
    Extract shared helpers and callouts into Wave 0 before builders start.
    Inspect linked_to milestones and cross-milestone task_depends_on blockers.
    Build cross-task seam matrix in SQLite.

  task.contract: >
    Define production-seam test for this task. Ensure additive seam evolution by
    strengthening existing test fixtures. Verify runtime-red assertion failure matching
    configured expected_failure.exit_codes rather than compilation or syntax errors.

  task.code: >
    Implement minimal production code to satisfy accepted seam test.
    Stay strictly within admitted task.scope (or approved task.extended_scope).

  task.deferred_final_test: >
    Load the `test-suite-refactor` skill to audit test reachability, replace temporary mocks
    with real production callers, and eliminate duplicate stubs accumulated during isolated
    worktree runs without weakening coverage. Load `test-contract-seam` to preserve settled
    invariants. Run the registered verification command and submit passing SeamTest proof (exit code 0).

  task.seam_review: >
    Independently review the reconciled seam changes across interdependent tasks.
    Verify that temporary stubs were safely eliminated without dropping test assertions,
    and that no regressions or scope leaks were introduced during seam integration.

  task.db_migration: >
    Verify database schema migrations and rollback safety. Ensure zero unmigrated model changes,
    no destructive data loss on schema transitions, and passing rollback tests.

  task.public_api: >
    Public API signatures, tool inputs, or exports were modified. Prompt agent to increment
    the repository SemVer version in the project manifest and document changes in release notes.

  # ===========================================================================
  # HITL ESCALATION CATALOG (Bound to 'hitl' guidance slot in milestone manifest)
  # ===========================================================================
  hitl.careless: >
    HITL GOVERNANCE LEVEL: CARELESS (Maximum Agent Autonomy).
    1. Scope & Symbols Autonomy: The Architect has 100% autonomous authority to admit,
       rename, split, or create new structs, traits, helper methods, and database columns.
    2. Zero Human Escalation: Escalation to human operators is strictly prohibited for
       interface, schema, or API changes.
    3. Escalation Exceptions: Escalate to human ONLY in unrecoverable infrastructure deadlocks:
       circular cross-task DAG blockers or fatal unrecoverable environment crashes.
    4. Arbitration Loop: On reviewer rejection, synthesize extended_symbols, increment
       contract_revision, produce Red Seam Test, and immediately dispatch back to builder.

  hitl.curious: >
    HITL GOVERNANCE LEVEL: CURIOUS (Informational Telemetry with High Autonomy).
    1. Autonomous Approvals: Architect autonomously approves module-internal symbols,
       refactorings, helper functions, and non-breaking trait implementations.
    2. Blackboard Telemetry: When a notable public signature or data structure is modified,
       Architect MUST post an informational event to task_blackboard (topic="telemetry",
       kind="interface_evolution") detailing the changes, but DOES NOT block execution.
    3. Mandatory Human Escalation: Escalate via A/B Decision Card ONLY on: breaking public
       library exports, irreversible database migrations, or new external package/library dependencies.

  hitl.pro: >
    HITL GOVERNANCE LEVEL: PRO (Professional Engineering Balance — Default).
    1. Permitted Autonomous Additions: Architect is authorized to self-admit into extended_symbols
       without human sign-off: module-internal helper functions, private classes, structs, or internal types,
       non-breaking error variants, internal test helpers/fixtures, documentation, and comments.
    2. Mandatory Human Escalation Triggers: Architect is STRICTLY PROHIBITED from self-approving
       and MUST escalate to a human on:
       - Public API Surface: Any alteration to public exports/interfaces exposed in root package entrypoints or public module exports.
       - CLI Commands & Arguments: Any new subcommand, altered flag, or changed default behavior.
       - Database & Storage: Any new SQLite/DB table, column schema modification, or index creation.
       - MCP Protocol Surface: Any new tool, altered tool arguments, or schema changes.
       - Cross-Milestone Contracts: Any change to symbols consumed by linked_to milestone tasks.
    3. Escalation Protocol: Post structured A/B Decision Card to task_blackboard and halt with human blocker.

  hitl.paranoic: >
    HITL GOVERNANCE LEVEL: PARANOIC (Zero Autonomous Interface Mutation).
    1. Absolute Zero Autonomy: Architect is strictly forbidden from self-approving ANY new symbol
       or signature modification into extended_symbols, including private helpers.
    2. Universal Escalation: Every single symbol deviation detected by the reviewer requires
       an explicit human sign-off through an A/B Decision Card on task_blackboard.
    3. Full Contract Freezing: Task cannot transition out of architect arbitration until a human
       explicitly posts an approval response on the blackboard with the chosen option.

  # Review Focus Lenses (Cognitive Contours)
  contour.paths: >
    Verify change boundaries: all modified files must be strictly within task.scope + task.extended_scope.
    If extended_scope is present, explicitly review the recorded reason and confirm justification.

  contour.claims: >
    Verify evidence: every acceptance claim must be proven by a reproducible test run.

  contour.concurrency: >
    Verify thread safety, SQLite transaction fences (IMMEDIATE), and lock acquisition order.

  contour.project_isolation: >
    Verify workspace isolation: ensure zero modification to sibling/external workspaces.

  contour.administration: >
    Verify administrative integrity: no unauthorized edits to receipts or Git hooks.

  milestone.review: >
    Evaluate integrated milestone changes against milestone invariants, ADRs,
    and cross-task seam boundaries. Verify receipts, proofs, and zero regression across all contours.

  milestone.polish: >
    Resolve integration failures, compilation breaks, or reviewer findings on the integrated milestone branch.
    Verify full test suite and submit for integration re-review.

  milestone.doc: >
    Audit all milestone changes against documentation scope.
    Reconcile README, reference docs, AGENTS.md, and skills with live code and tests.

  milestone.handoff: >
    Terminal milestone delivery. Handoff does not fail closed on working tree modifications
    from documentation polish, test adjustments, or minor bugfixes; it absorbs all remaining
    milestone changes into the definitive integration commit, captures the full milestone
    telemetry passport, writes the archive manifest to docs/milestones/archive/<slug>.md, and
    purges transient milestone records from SQLite while retaining milestone_tombstones.
    Any source changes absorbed during handoff require re-running full repository verification
    and obtaining final reviewer sign-off bound to the final content tree (TESTS.md).

# =============================================================================
# 4. POLICIES & TEMPLATES
# =============================================================================
subtask_dod:
  - "Contract slice resolution: Demonstrably resolves an explicit, bounded slice of the contract without breaking boundaries."
  - "Milestone & ADR alignment: Builds upon existing architectural seams rather than ad-hoc isolated patches."
  - "Production-seam evidence: Validates through real production paths rather than synthetic stubs mocking away system complexity."
  - "Systemic non-regression: Zero warnings/lints and complete behavioral preservation of untouched invariants."
  - "Anti-looping invariant: If an approach fails after 2 iterations, halt, post blockers to task_blackboard, retain fail-closed behavior, and escalate."

policies:
  default_review:
    independent_worker: true
    require_all_contours: true
    audit_extended_scope: true       # Requires explicit reviewer sign-off if extended_scope exists

# Reusable nested subgraphs
gate_templates:
  build_review_cycle:
    gates:
      - id: build
        role: builder
        guidance: [task.code]
        command: check_task
        proof: command
        persistence:
          pre: snapshot              # Captures starting state of builder turn
          post: snapshot             # Captures candidate snapshot of implemented code

      - id: review
        role: reviewer
        policy: default_review
        proof: review
        reject_routing:
          scope: build               # Unadmitted files or implementation defects route to build gate (builder)
          symbols: contract          # Interface/symbol drift or contract gaps route to architect contract gate
        persistence:
          immutable: true            # Prohibits any file mutation during review; must match candidate snapshot!

# =============================================================================
# 5. HIERARCHICAL GATES TREE (`gates`)
# =============================================================================
gates:
  # Gate 1: Upfront Milestone Synthesis & DAG Optimization (Agent Gate)
  - id: contract_synthesis
    role: architect
    guidance: [milestone.synthesis, hitl]
    proof: contract
    persistence:
      pre: snapshot                  # Captures pristine working tree before architect reshuffles tasks/manifest
      post: commit                   # Commits synthesized contracts and optimized wave plan to milestone branch
      restore_on_reject: true        # Restores tree to pristine pre-snapshot if synthesis fails

  # Gate 2: Milestone Tasks Container (First-class declarative task lifecycle)
  # Default task type is type: ["code"]. Non-code tasks (type: ["doc"], type: ["db"]) skip code gates automatically.
  # Sub-profiles applied to individual tasks simply extract this `tasks:` block directly.
  - tasks:
      gates:
      # Sub-Gate 2.1: Task Contract (Agent Gate)
      # Executes for code tasks to define runtime-red production-seam test baseline.
      - id: contract
        when: code
        role: architect
        guidance: [task.contract, hitl]
        proof: contract
        expected_failure:
          exit_codes: [1, 101, 134]          # Language-agnostic: Rust=101, Python/pytest=1, C=134
          stderr_contains: "assertion failed" # Distinguishes runtime assertion from compiler/syntax error
        persistence:
          post: snapshot             # Captures red-seam baseline snapshot

      # Sub-Gate 2.2: Task Build (Agent Gate)
      # Builder implements code to pass seam test and executes check_task.
      - id: build
        when: code
        role: builder
        guidance: [task.code]
        command: check_task
        proof: command
        persistence:
          pre: snapshot              # Captures starting state of builder turn
          post: snapshot             # Captures candidate snapshot of implemented code

      # Sub-Gate 2.3: Database Migration Verification (Conditional Gate)
      # Triggers when task.type has "db" or task.scope touches migration files
      - id: migration_check
        when: db_migration
        role: builder
        guidance: [task.db_migration]
        command: verify_migration
        proof: command
        reject_to: build

      # Sub-Gate 2.4: Independent Review of Task Candidate (Agent Gate)
      - id: review
        role: reviewer
        policy: default_review
        proof: review
        independent_from: build
        reject_routing:
          scope: build               # Unadmitted files or implementation defects route to build gate
          symbols: contract          # Interface/symbol drift or contract gaps route to architect contract gate
        persistence:
          immutable: true            # Strictly enforces that tree matches reviewed candidate snapshot

      # Sub-Gate 2.5: Joint Seam Integration & Review (Container Gate)
      # Executes conditionally when the task participates in an active dependency relationship in the DAG.
      # If the task is isolated (0 dependencies, 0 dependents), the entire seam container is automatically skipped.
      - id: seam
        when: seam                   # Pure topological property of DAG (code, doc, or observer tasks)
        gates:
          - id: integrate
            when: code               # Code tasks compile & verify seam tests; doc/observer tasks skip
            role: builder
            guidance: [task.deferred_final_test]
            command: check_task
            proof: seam_test         # SeamTestProof: validates all referenced seam_test_refs actually passed
            persistence:
              post: snapshot

          - id: review
            role: reviewer
            guidance: [task.seam_review]
            proof: review
            independent_from: seam.integrate
            reject_to: integrate
            persistence:
              immutable: true

      # Sub-Gate 2.6: Autonomous Task Delivery (0 Tokens: Atomic Git commit & receipt)
      # Coordinated Delivery Barrier: lands candidate snapshot after individual and seam reviews pass.
      # Sequential hard blockers deliver immediately; barrier coordinates speculative/parallel tasks.
      - id: deliver
        proof: delivery
        receipt: true                # Emits durable receipt and sets status: completed
        persistence:
          immutable: true            # Strictly enforces that tree matches reviewed candidate snapshot
          post: commit               # Lands candidate snapshot into milestone branch Git HEAD
          git_commit_note: telemetry # Default: automated task engineering passport (diff breakdown, AST symbols, test suite, swarm)

  # Gate 3: Milestone Integration Verification & Polish
  - id: milestone_verification
    gates:
      # Sub-Gate 3.1: Public API SemVer & Changelog Verification (Conditional Gate)
      # Triggers at milestone level when AST detects modified public API exports, MCP tool schemas, or CLI commands
      - id: api_version_bump
        when: public_api
        role: builder
        guidance: [task.public_api]
        proof: command

      # Sub-Gate 3.2: Full Repository Verification (Command Gate)
      - id: verify
        command: check_full_repo

      # Sub-Gate 3.3: Integration Review (Agent Gate)
      - id: review
        role: reviewer
        policy: default_review
        guidance: [milestone.review]
        proof: review
        persistence:
          immutable: true

    # Fallback subgraph if verification fails (parameterized with check_full_repo):
    fallback:
      use: build_review_cycle
      command: check_full_repo
      guidance: [milestone.polish]
      max_attempts: 2

    # Autonomous delivery of milestone integration polish (if verified/repaired):
    deliver:
      proof: delivery
      receipt: true
      persistence:
        immutable: true
        post: commit

  # Gate 4: Milestone Documentation (Agent Gate)
  - id: documentation
    role: doc_writer
    guidance: [milestone.doc]
    proof: review
    persistence:
      pre: snapshot
      post: commit

  # Gate 5: Terminal Milestone Handoff (Agent Gate)
  - id: handoff
    role: architect
    guidance: [milestone.handoff]
    proof: delivery
    absorb_working_tree: true        # Absorbs remaining test/doc polish into milestone integration commit
    persistence:
      post: commit
      git_commit_note: telemetry     # Attaches complete milestone telemetry passport
      # Alternative (command-driven custom benchmark / verification script):
      # git_commit_note: command.benchmark

