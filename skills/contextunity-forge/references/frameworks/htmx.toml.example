# Copy to .forge/frameworks/htmx.toml.
# This is a partial extension of the bundled pack, using its exact rule identities.
# Default merging retains other bundled rules; matching identities are replaced.
# Keep replace omitted; replace=true would discard unlisted bundled rules.
# To disable the effective pack, add enabled=false to this complete valid manifest.
# Literal local request URLs join one backend route; hx-target/hx-swap are context.
# Remote, dynamic and current-page values create no exact endpoint edge.

[[syntax_rules]]
id = "request-attributes"
language = "html"
operation = { kind = "html_request_attributes", request_node = "htmx_request", context_node = "htmx_context", namespace = "htmx", context_label = "HTMX context", prefixes = ["hx-", "data-hx-"], methods = { get = "GET", post = "POST", put = "PUT", patch = "PATCH", delete = "DELETE" }, contexts = ["trigger", "target", "swap", "include"], values = "vals", value_dynamic_prefixes = ["js:", "javascript:"] }
