# Example .forge/frameworks/gridviewspec.toml
# Public members verified against grid-view-spec commit a2d037dff7cef99b820fbf212d21042bc5a90ca7.
# Concrete block/action rules include inherited fields; the Django host has methods.
# GridViewAction is a union alias, represented by its real base and six variants.
[[class_hierarchy_receivers]]
bases = ["grid_view_spec.types.spec.GridViewSpec", "grid_view_spec.types.GridViewSpec"]
provider = "grid_view_spec.types.spec.GridViewSpec"
members = ["id", "title", "meta", "config", "blocks", "layout"]

[[class_hierarchy_receivers]]
bases = ["grid_view_spec.types.block_base.GridViewBlockBase", "grid_view_spec.types.GridViewBlockBase"]
provider = "grid_view_spec.types.block_base.GridViewBlockBase"
members = ["id", "type", "title", "extra", "style", "trusted_style", "lazy"]

