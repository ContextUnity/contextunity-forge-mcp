# Example .forge/frameworks/alpinejs.toml
# Package APIs and directive attributes are generic syntax-rule data.
[[syntax_rules]]
id = "implicit-receivers"
language = "javascript"
activation = [{ kind = "package", name = "alpinejs" }]
operation = { kind = "implicit_receivers", names = ["$el", "$refs", "$event", "$dispatch", "$nextTick", "$watch", "$store", "$data", "$id", "$root", "$parent"] }

[[syntax_rules]]
id = "script-attributes"
language = "html"
operation = { kind = "html_script_attributes", event_prefixes = ["@", "x-on:"], object_attribute = "x-data", event_scope = "alpine_event", object_scope = "alpine_data" }
