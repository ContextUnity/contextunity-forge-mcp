# Copy to .forge/frameworks/nuxt.toml.
# This is a partial extension of the bundled pack, using its exact rule identities.
# Default merging retains other bundled rules; matching identities are replaced.
# Keep replace omitted; replace=true would discard unlisted bundled rules.
# To disable the effective pack, add enabled=false to this complete valid manifest.
# The component environment requires Nuxt package/configuration proof.
# Module exports use actual indexed .ts named exports; no use* name guessing.
# Configured setup returns expose actual callables; i18n result t remains external.
# components=false controls component discovery independently of module contracts.

receivers = []
builtins = []
filters = []
routes = []

[[syntax_rules]]
id = "components"
display = { autoimport = "builtin:nuxt_autoimport", component = "builtin:nuxt" }
language = "typescript"
operation = { kind = "component_environment", package = "nuxt", config_file = "nuxt.config.ts", config_callee = "defineNuxtConfig", enabled_key = "components", modules_key = "modules", directory = "components", extension = ".vue", virtual_module = "#components", autoimports = ["computed", "ref", "useFetch", "useAsyncData", "$fetch", "useRuntimeConfig", "createError", "defineEventHandler", "readBody", "setHeader", "defineNuxtConfig", "watch", "reactive", "onBeforeUnmount", "onUnmounted", "navigateTo"], builtins = ["ClientOnly", "NuxtLayout", "NuxtPage"], modules = { "radix-vue/nuxt" = { package = "radix-vue", components = ["DialogRoot", "DialogPortal", "DialogOverlay", "DialogContent", "DialogTitle", "DialogDescription", "DialogClose", "DropdownMenuRoot", "DropdownMenuTrigger", "DropdownMenuContent", "DropdownMenuItem", "DropdownMenuPortal", "DropdownMenuSeparator", "DropdownMenuSub", "DropdownMenuSubTrigger", "DropdownMenuSubContent", "TabsRoot", "TabsList", "TabsTrigger", "TabsContent", "ToggleGroupRoot", "ToggleGroupItem", "SliderRoot", "SliderTrack", "SliderRange", "SliderThumb", "ToastProvider", "ToastRoot", "ToastTitle", "ToastDescription", "ToastClose", "ToastViewport", "HoverCardRoot", "HoverCardTrigger", "HoverCardPortal", "HoverCardContent", "HoverCardArrow"] }, "@pinia/nuxt" = { package = "pinia", components = [], exports = [{ directory = "stores", extension = ".ts" }] }, "@nuxtjs/i18n" = { package = "@nuxtjs/i18n", components = [], call_results = { useI18n = ["t"] } } } }

[[syntax_rules]]
id = "configured-setup-store"
language = "typescript"
activation = [{ kind = "package", name = "pinia" }]
operation = { kind = "factory_members", callee = { kind = "global", name = "defineStore" }, argument = 1, shape = "setup_return", configured_module = "@pinia/nuxt" }

[[syntax_rules]]
id = "fetch-autoimport"
language = "vue"
activation = [{ kind = "package", name = "nuxt" }]
display = { builtin = "builtin:nuxt_autoimport" }
operation = { kind = "implicit_builtins", names = ["$fetch"] }

[[syntax_rules]]
id = "pages"
language = "vue"
activation = [{ kind = "package", name = "nuxt" }]
operation = { kind = "file_route", directory = "pages/", extension = ".vue", index = "index", method = "GET" }
