# Copy to .forge/frameworks/project-rules.yaml. Identity is the filename stem.
# Default merging retains other bundled rules; matching identities are replaced. Use replace: true for full replacement.
# Set enabled: false to disable this entire effective pack.
enabled: true
class_hierarchy_receivers:
  - bases: [django.custom.Base]
    provider: django.custom.Base
    members: [deliver]
    returns: {deliver: {kind: self}}
route_decorators:
  - callee: portal.expose
    method: POST
    path_argument: 0
    receiver_names: []
    allow_relative_path: false
route_calls:
  - callee: register_endpoint
    method: GET
    path_argument: 0
    # First handler position; subsequent positional middleware handlers also apply.
    handler_argument: 1
    receiver_names: []
    allow_relative_path: false
di_calls:
  - callee: InjectService
    argument: 0

semantic_rules:
  - id: portal-render
    namespace: templates
    scope: project
    activation: []
    operation:
      kind: call_to_file
      language: python
      callee: {kind: imported, module: portal.responses, export: render_file}
      argument: 1
      target: {kind: project_path_suffix, prefix: templates/, language: html}
      relation: renders_template

syntax_rules:
  - id: portal-route-key
    language: python
    operation:
      kind: named_route_call
      module: portal.urls
      export: lookup
      argument: 0
      expression_prefix: portal.route.
  # Illustrative policy names: substitute verified package, configuration and API identities.
  - id: demo-environment
    language: typescript
    operation:
      kind: component_environment
      package: demo-runtime
      config_file: demo.config.ts
      config_callee: defineDemoConfig
      enabled_key: components
      modules_key: modules
      directory: components
      extension: .vue
      virtual_module: '#demo-components'
      autoimports: []
      builtins: []
      modules:
        demo-store/module:
          package: demo-store
          components: []
          exports: [{directory: state, extension: .ts}]
        demo-i18n/module:
          package: demo-i18n
          components: []
          call_results: {useDemoLocale: [translate]}
  - id: demo-setup-factory
    language: typescript
    operation:
      kind: factory_members
      callee: {kind: global, name: defineDemoStore}
      argument: 1
      shape: setup_return
      configured_module: demo-store/module
  # frontend must own demo-runtime; missing providers stay nonexact.
  # Replace the empty workspace with an enabled adapter alias to select a linked workspace.
  - id: demo-renderer-reference
    language: python
    operation:
      kind: named_binding
      domain: demo_renderer
      binding:
        kind: call_reference
        callee: {kind: imported, module: demo.tables, export: Column}
        key: {kind: keyword, name: renderer}
        provider_scopes: [{workspace: '', project: frontend, package: demo-runtime}]
  # Imported receiver proof plus provider-relative root, not a global filter name.
  - id: demo-filter-definition
    language: python
    operation:
      kind: named_binding
      domain: demo_filters
      binding:
        kind: assignment_definition
        receiver_type: {module: jinja2, export: Environment}
        member: filters
        template_root: templates
  - id: demo-filter-reference
    language: html
    operation:
      kind: named_binding
      domain: demo_filters
      binding: {kind: template_reference, symbol_kind: filter}
  # Verify the actual client/app chain before asserting these exact paths.
  - id: demo-client-context
    language: python
    operation:
      kind: http_client_call
      callee: ''
      receivers: [demo_client]
      methods: {get: GET, post: POST}
      default_method: GET
      url_key: url
      method_key: method
      relative_prefixes: ['/']
      target_context:
        request_owners: [tests/test_api.py]
        route_owners: [app/routes.py]
  - id: demo-literal-receiver
    language: typescript
    operation:
      kind: receiver_type
      receiver:
        name: DemoInput
        members: []
        properties: {value: string}
        callback_callees: []
        generic: false
        argument_factories:
          - callee: {kind: global_member, receiver: demoDocument, member: create}
            argument: 0
            literals: [entry]
