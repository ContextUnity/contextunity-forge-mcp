# =============================================================================
# CANONICAL HIERARCHICAL ACDD PROFILE SPECIFICATION
# Standalone reference example (`inherit: none`) of a declarative ACDD profile.
#
# Tip: Most repositories only need a compact overlay (`inherit: default`) in
# `.forge/acdd/profile.yaml` defining project `commands`, `scope_args_by_pattern`,
# and gate `command` bindings; see `docs/reference/acdd.md` and `profiles.md`.
#
# Core Architectural Principles:
# 1. Everything is a Gate (`gates:`):
#    - Agent Gate:   has `role: <id>`    -> Claimed by agent worker via `task claim`.
#    - Command Gate: has `command: <cmd>` -> Executed autonomously by engine (0 tokens).
#    - Container:    has `gates: [...]` or `tasks: { gates: [...] }` -> Nests child gates.
# 2. Save Policy (`save:`):
#    - `pre: snapshot | commit` (default none) -> State capture on claim.
#    - `post: snapshot | commit` (default none) -> State capture/commit on stage pass.
#    - `immutable: true` (default false) -> Prohibits file modifications during gate.
#    - `git_commit_note: telemetry` -> Attaches telemetry note to Git commit.
# 3. Guidance Catalog (`guidance:`):
#    - Central catalog for task guidance, HITL escalation slots (`hitl` / `hitl.pro`),
#      DoD, and review contours (`contour.<name>`).
# =============================================================================

version: 2
inherit: none

limits:
  max_metadata_bytes: 2048       # 2 KiB limit for arbitrary task/gate metadata & metrics
  max_trace_summary_bytes: 2048  # Tail output size for execution traces
  diagnostic_inline_bytes: 4096  # Persist full logs only when diagnostics exceed this budget.
  max_command_timeout_seconds: 1800

git_commit_note:
  limits:
    max_bytes: 2048              # 2 KiB limit for Git notes attached to refs/notes/forge
  format: markdown
  telemetry:
    format: markdown
    sections:
      - duration: true           # Total elapsed time
      - tasks_summary: true      # Completed tasks count and durations
      - review_cycles: true      # Iterations and review rejections count
      - diff_breakdown: true     # Line additions/deletions categorized by src, tests, docs
      - ast_delta: true          # Net change in AST symbols
      - test_suite: true         # Test counts passed/failed and linter status
      - topology: true           # Upstream blockers and downstream dependents

# Declarative proof catalog
proofs:
  blueprint:
    description: "Architectural blueprint with grounded citations and per-task slices"
    schema:
      type: object
      required:
        - cited_invariants
        - cited_symbols
        - global_negative_boundaries
        - blackboard_decision_id
        - tasks
      properties:
        cited_invariants:
          type: array
          items: { type: string }
        cited_symbols:
          type: array
          items: { type: string }
        global_negative_boundaries:
          type: array
          items: { type: string }
        blackboard_decision_id: { type: string }
        tasks:
          type: object
          additionalProperties:
            type: object
            required:
              - layer
              - summary
              - exported_interfaces
              - negative_boundaries
              - incoming_seams
              - outgoing_seams
            properties:
              layer: { type: string }
              summary: { type: string }
              exported_interfaces:
                type: array
                items: { type: string }
              negative_boundaries:
                type: array
                items: { type: string }
              verification_seam: { type: string }
              incoming_seams:
                type: array
                items:
                  type: object
                  required: [source_task, contract_type, contract_ref, specification]
                  properties:
                    source_task: { type: string }
                    contract_type:
                      type: string
                      enum: ["seam_dependency", "shared_type", "shared_helper"]
                    contract_ref: { type: string }
                    specification: { type: string }
              outgoing_seams:
                type: array
                items:
                  type: object
                  required: [target_task, contract_type, contract_ref, specification]
                  properties:
                    target_task: { type: string }
                    contract_type:
                      type: string
                      enum: ["seam_dependency", "shared_type", "shared_helper"]
                    contract_ref: { type: string }
                    specification: { type: string }

  contract:
    description: "Proof of runtime assertion failure proving red seam baseline"
    schema:
      type: object
      required: [contract_proof]
      properties:
        contract_proof:
          type: object
          required: [seam_test_ref, red_exit_code]
          properties:
            seam_test_ref: { type: string }
            red_exit_code: { type: integer }

  command:
    description: "Autonomous command execution proof (exit code 0, passed linters/tests)"
    schema:
      type: object
      required: [command_proof]
      properties:
        command_proof:
          type: object
          required: [command, exit_code]
          properties:
            command: { type: string }
            exit_code: { type: integer, const: 0 }
            tests_passed: { type: integer }
            tests_failed: { type: integer, const: 0 }

  review:
    description: "Independent cognitive review sign-off across focus lenses"
    schema:
      type: object
      required: [review_proof]
      properties:
        review_proof:
          type: object
          required: [decision, contours]
          properties:
            decision: { type: string, enum: ["pass", "reject"] }
            contours: { type: object }
            extended_scope_review:
              type: object
              properties:
                approved_paths: { type: array, items: { type: string } }
                reason_verified: { type: boolean }
            notes: { type: string }

  seam_test:
    description: "Joint seam integration proof verifying all referenced cross-task tests passed"
    schema:
      type: object
      required: [seam_test_proof]
      properties:
        seam_test_proof:
          type: object
          required: [exit_code, seam_test_refs]
          properties:
            exit_code: { type: integer, const: 0 }
            seam_test_refs: { type: array, items: { type: string } }
            tests_passed: { type: integer }
            tests_failed: { type: integer, const: 0 }

  delivery:
    description: "Autonomous delivery receipt and atomic Git commit proof"
    schema:
      type: object
      required: [delivery_proof]
      properties:
        delivery_proof:
          type: object
          required: [delivered]
          properties:
            delivered: { type: boolean }
            commit_sha: { type: string }
            receipt_id: { type: string }

# Worker roles and recommended models
roles:
  contract_author:
    mode: subagent
    reuse_on_reject: true
    models:
      - 'sol-6.1:high'
    guidance: "Lead architectural planning for this task before writing tests: trace data flow, define typed invariants, specify negative boundaries, and write compiling runtime-red seam tests. Post a build-targeted draft to task_blackboard."

  builder:
    mode: subagent
    reuse_on_reject: true
    models:
      - 'gpt6-luna:xhigh'
      - 'sol-6.1:medium'
    guidance: "Implement the approved contract inside the declared allowed_write_scope and verify tests."

  independent_reviewer:
    mode: subagent
    reuse_on_reject: true
    models:
      - 'sol-6.1:xhigh'
    guidance: "Use a reviewer worker independent from the builder. Audit subsystem integration, performance, and test hygiene. Reject superficial heuristics and duplicate algorithms. Submit review proof across contours, then claim and submit deliver in the same reviewer session."

  architect:
    mode: subagent
    reuse_on_reject: true
    models:
      - 'sol-6.1:high'
    guidance: "Ground architectural decisions in repository symbols, invariants, and extension seams. Define Clean Architecture layer boundaries, per-task slices, and cross-task seams, then record the decision on task_blackboard."

# Scoped arguments augment the selected command for affected paths.
scope_args_by_pattern:
  "src/main.rs": "--bin contextunity-forge-mcp"
  "src/**/*.rs": "--lib"
  "crates/forge-core/**/*.rs": "--package forge-core --lib"
  "crates/forge-index/**/*.rs": "--package forge-index --lib"
  "crates/forge-tasks/**/*.rs": "--package forge-tasks --lib"
  "tests/*.rs": "--test {file_stem}"
  "tests/acdd/**/*.rs": "--test acdd"

# Registered commands
commands:
  rust-check-and-test:
    output: &test_output
      counts:
        passed: '(?m)\b(\d+) passed\b'
        failed: '(?m)\b(\d+) failed\b'
      require_counts: true
      noise: ['^\s*(Compiling|Downloading|Finished|Checking)\b', '^✔']
      errors: ['^error(\[E\d+\])?:', 'panicked at', '^FAIL ', '^AssertionError:', '^\s*AssertionError']
      tests:
        target: '(?m)(?:^\s*Running\s+(?:unittests\s+)?|"kind":\s*\[[^\]]*"test"[^\]]*\].*?"src_path":\s*"|--test\s+|^===\s+RUN\s+|^PASS\s+|^FAIL\s+)([^\s"\\)]+)'
        passed: '(?m)(?:^test\s+([A-Za-z0-9_:]+)\s+\.\.\.\s+ok\b|(?:\b|\s)([A-Za-z0-9_:]+)\s+PASSED\b|^\s*✓\s+([^\n]+)|---\s+PASS:\s+([A-Za-z0-9_:]+))'
        failed: '(?m)(?:^test\s+([A-Za-z0-9_:]+)\s+\.\.\.\s+FAILED\b|(?:\b|\s)([A-Za-z0-9_:]+)\s+FAILED\b|^\s*✕\s+([^\n]+)|---\s+FAIL:\s+([A-Za-z0-9_:]+))'
        ignored: '(?m)(?:^test\s+([A-Za-z0-9_:]+)\s+\.\.\.\s+ignored\b|(?:\b|\s)([A-Za-z0-9_:]+)\s+SKIPPED\b|^\s*○\s+([^\n]+)|---\s+SKIP:\s+([A-Za-z0-9_:]+))'
    by_pattern:
      "**/*.py": "pytest"
      "**/*.{ts,tsx,js,jsx,vue}": "npm test"
      "**/*.go": "go test ./..."
      "**/*.rs": "cargo clippy --all-targets --all-features -- -D warnings && cargo test"
    description: "Run strict repository checks and lints followed by the test suite."

  check_full_repo:
    output: *test_output
    by_pattern:
      "**/*.py": "pytest"
      "**/*.{ts,tsx,js,jsx,vue}": "npm test"
      "**/*.go": "go test ./..."
      "**/*.rs": "cargo clippy --all-targets --all-features -- -D warnings && cargo test --all-targets"
    description: "Run the full repository verification commands."
    timeout_seconds: 1800

  lint:
    output:
      require_counts: false
      noise: ['^\s*(Checking|Compiling|Finished)\b']
      errors: ['^error(\[E\d+\])?:']
    by_pattern:
      "**/*.py": "ruff check ."
      "**/*.{ts,tsx,js,jsx,vue}": "npm run lint"
      "**/*.go": "go vet ./..."
      "**/*.rs": "cargo clippy --all-targets --all-features -- -D warnings"
    description: "Run language-specific linter without running tests."

  test:
    output: *test_output
    by_pattern:
      "**/*.py": "pytest"
      "**/*.{ts,tsx,js,jsx,vue}": "npm test"
      "**/*.go": "go test ./..."
      "**/*.rs": "cargo test"
    description: "Run test suite across supported languages."

polish_scope:
  - ".forge/**"
  - "docs/**"
  - "skills/**"
  - "AGENTS.md"
  - "**/AGENTS.md"
  - "README.md"
  - ".gitignore"

# Central guidance catalog
guidance:
  task.contract:
    description: "PRODUCTION-SEAM CONTRACT AUTHORING & RUNTIME-RED PROOF"
    criteria:
      - "Analyze subsystem data flow, define typed invariants, and specify negative boundaries before authoring tests."
      - "Compile a runtime-red seam test failing on assertions (exit code 101/1/134) as executable proof of the contract."
      - "Extend table-driven cases additively for existing units; author dedicated test functions for distinct capabilities."
      - "Avoid duplicate mechanisms or touching protected paths outside admitted task scope."

  task.code: "Implement the accepted seam with the smallest change that satisfies the task contract."

  task.review:
    description: "INDEPENDENT REVIEW CORE INVARIANTS & ENGINEERING PRINCIPLES"
    criteria:
      - "Evaluate diffs in full subsystem context using Forge MCP tools (`code_map_inspect`, `code_map_impact`, `ast_grep_search`, `forge_read`)."
      - "Reject superficial heuristics, parallel hardcoded lookup lists, duplicate algorithms, and monolithic test functions."
      - "Treat review contours as an analytical framework and formulate constructive, evidence-backed findings."

  task.deferred_final_test: "Run the registered verification command and submit passing seam test proof."
  task.seam_review: "Review joint seam changes across interdependent tasks."

  hitl.careless: "HITL level CARELESS: allow autonomous changes; escalate only for unrecoverable infrastructure or circular dependencies."
  hitl.curious: "HITL level CURIOUS: report interface evolution; escalate breaking public APIs or irreversible storage changes."
  hitl.pro: "HITL level PRO: allow internal helpers; escalate public APIs, CLI/MCP surfaces, storage schemas, and cross-milestone contracts."
  hitl.paranoic: "HITL level PARANOIC: require explicit human approval for every new symbol or signature before contract admission."

  subtask.dod:
    description: "Definition of done for all subtasks"
    criteria:
      - "Resolves an explicit bounded slice of the contract using production-seam evidence."
      - "Leaves zero compiler warnings or linter errors."

  review.policy:
    description: "Defect routing and scope boundaries for review gates"
    criteria:
      - "Route adjacent defects to their owning task or admit scope before edits; record deferred findings durably."

  contour.paths:
    description: "Verify changes stay within the task's admitted write perimeter and preserve protected paths."
    criteria:
      - "Compare every changed, staged, untracked, and generated file with the task's initial scope and admitted extensions."
      - "Verify configuration, credentials, and sibling project paths were not modified outside scope."

  contour.claims:
    description: "Verify each accepted contract claim is implemented and supported by production-seam evidence."
    criteria:
      - "Trace every invariant and acceptance criterion to the production code path and real seam test."

  contour.concurrency:
    description: "Verify concurrent operations cannot admit stale authority, lose receipts, or publish partial task state."
    criteria:
      - "Check transaction boundaries, revision fencing, claim ownership, and rollback safety."

  contour.project_isolation:
    description: "Verify task data, profiles, paths, and Git operations stay within the owning workspace and project."
    criteria:
      - "Confirm workspace resolution confines paths, symlinks, and task rows to the active repository root."

  contour.administration:
    description: "Verify protected configuration, migration, profile pins, and privileged delivery behavior remain governed."
    criteria:
      - "Check schema integrity, profile pins, Git hooks, and landed receipt commits."

  milestone.synthesis: "Ground the milestone blueprint in repository symbols and invariants, define Clean Architecture slices and cross-task seams, and record the decision on task_blackboard."
  milestone.blueprint_review: "Verify cited symbols and invariants exist, Clean Architecture boundaries hold, and per-task seam slices are consistent."
  milestone.review: "Audit the integrated milestone diff against target base for cohesion, performance invariants, and analytical contours."
  milestone.polish: "Resolve integration failures or reviewer findings on the integrated milestone branch."
  milestone.handoff: "Terminal milestone delivery, capturing telemetry passport and archiving milestone."

# Policies catalog
policies:
  proof:
    command:
      require_zero_exit: true
      max_log_bytes: 98304
  review:
    independent_worker: true
    require_all_contours: true
  delivery:
    atomic_receipt: true
  default_review:
    independent_worker: true
    require_all_contours: true
    audit_extended_scope: true

# Hierarchical workflow: blueprint synthesis -> per-task container -> verify / polish / review / handoff.
gates:
  - id: blueprint_synthesis
    gates:
      - id: synthesize
        role: architect
        guidance: [milestone.synthesis, hitl.pro]
        tools:
          - code_map_inspect
          - code_map_impact
          - code_map_overview
          - code_map_search
          - ast_grep_search
          - forge_read
          - task_blackboard
        proof: blueprint
        save:
          pre: snapshot
          post: snapshot
      - id: review
        role: independent_reviewer
        guidance: [milestone.blueprint_review, hitl.pro]
        policy: default_review
        contours: guidance.contours
        independent_from: synthesize
        fail: synthesize
        tools:
          - code_map_inspect
          - code_map_impact
          - code_map_search
          - ast_grep_search
          - forge_read
          - task_blackboard
        save:
          immutable: true

  - tasks:
      gates:
        - id: contract
          role: contract_author
          tools: [forge_read]
          command: test
          guidance: [task.contract, hitl.pro]
          expected_failure:
            exit_codes: [1, 101, 134]
          save: snapshot

        - id: build
          role: builder
          guidance: [task.code, hitl.pro]
          command: rust-check-and-test
          save:
            pre: snapshot
            post: snapshot

        - id: review
          role: independent_reviewer
          guidance: [task.review, hitl.pro]
          policy: default_review
          contours: guidance.contours
          independent_from: build
          fail: build
          loop:
            scope: build
            symbols: contract
          save:
            immutable: true

        - id: seam
          when: seam
          gates:
            - id: integrate
              proof: seam_test
              role: builder
              guidance: [task.deferred_final_test, hitl.pro]
              command: rust-check-and-test
              save:
                pre: snapshot
                post: snapshot
            - id: review
              role: independent_reviewer
              guidance: [task.seam_review, hitl.pro]
              policy: default_review
              contours: guidance.contours
              independent_from: integrate
              fail: integrate
              loop:
                scope: integrate
                symbols: contract
              save:
                immutable: true

        - id: deliver
          role: independent_reviewer
          guidance: [hitl.pro]
          receipt: true
          need: [review]
          independent_from: build
          fail: build
          save:
            immutable: true
            post: commit
            git_commit_note: telemetry

  - id: verify
    command: check_full_repo
    proof: command
    max_attempts: 2
    pass: milestone_review
    fail: polish

  - id: polish
    role: architect
    max_attempts: 2
    guidance: [milestone.polish, hitl]
    tools: [forge_read, search_docs, get_doc, task_blackboard]
    pass: verify
    save:
      pre: snapshot
      post: snapshot

  - id: milestone_review
    role: independent_reviewer
    max_attempts: 2
    policy: default_review
    guidance: [milestone.review]
    contours: guidance.contours
    independent_from: polish
    pass: handoff
    fail: polish
    save:
      immutable: true

  - id: handoff
    receipt: true
    absorb: true
    save: commit
