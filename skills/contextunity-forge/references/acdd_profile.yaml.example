# =============================================================================
# CANONICAL HIERARCHICAL ACDD PROFILE SPECIFICATION (v2)
# Reference example of an executable, fully declarative ACDD profile.
#
# Core Architectural Principles:
# 1. Everything is a Gate (`gates:`):
#    - Agent Gate:   has `role: <id>`    -> Claimed by agent worker via `task claim`.
#    - Command Gate: has `command: <cmd>` -> Executed autonomously by engine (0 tokens).
# 2. Unified Persistence Policy (`persistence:`):
#    - `pre: snapshot | commit` (default none) -> State capture on claim.
#    - `post: snapshot | commit` (default none) -> State capture/commit on stage pass.
#    - `immutable: true` (default false) -> Prohibits file modifications during gate.
#    - `git_commit_note: telemetry` -> Attaches telemetry note to Git commit.
# 3. Guidance Catalog (`guidance:`):
#    - Central catalog for task guidance, HITL escalation rules, DoD, and review contours.
#    - Gates reference guidance entries via `guidance: [entry1, entry2]`.
# 4. Review Contours (`contour.<name>`):
#    - Focus lenses with structured `description` and operational `criteria`.
# =============================================================================

version: 2

# Module selections use profile/enabled/disabled/required, not adapter boolean overrides.
modules:
  profile: full
  enabled: [codemap, docs, acdd, blackboard]
  disabled: []
  required: [acdd]

limits:
  max_metadata_bytes: 2048       # 2 KiB limit for arbitrary task/gate metadata & metrics
  max_trace_summary_bytes: 2048  # Tail output size for execution traces
  diagnostic_inline_bytes: 4096 # Persist full logs only when diagnostics exceed this budget.
  max_command_timeout_seconds: 1800

git_commit_note:
  limits:
    max_bytes: 2048              # 2 KiB limit for Git notes attached to refs/notes/forge
  format: markdown
  telemetry:
    format: markdown
    sections:
      - duration: true           # Total elapsed time
      - tasks_summary: true      # Completed tasks count and durations
      - review_cycles: true      # Iterations and review rejections count
      - diff_breakdown: true     # Line additions/deletions categorized by src, tests, docs
      - ast_delta: true          # Net change in AST symbols
      - test_suite: true         # Test counts passed/failed and linter status
      - topology: true           # Upstream blockers and downstream dependents

# Declarative proof catalog
proofs:
  contract:
    description: "Proof of runtime assertion failure (exit 101/1/134) proving red seam baseline"
    schema:
      type: object
      required: [contract_proof]
      properties:
        contract_proof:
          type: object
          required: [seam_test_ref, red_exit_code]
          properties:
            seam_test_ref: { type: string }
            red_exit_code: { type: integer }

  command:
    description: "Autonomous command execution proof (exit code 0, passed linters/tests)"
    schema:
      type: object
      required: [command_proof]
      properties:
        command_proof:
          type: object
          required: [command, exit_code]
          properties:
            command: { type: string }
            exit_code: { type: integer, const: 0 }
            tests_passed: { type: integer }
            tests_failed: { type: integer, const: 0 }

  review:
    description: "Independent cognitive review sign-off across focus lenses"
    schema:
      type: object
      required: [review_proof]
      properties:
        review_proof:
          type: object
          required: [decision, contours]
          properties:
            decision: { type: string, enum: ["pass", "reject"] }
            contours: { type: object }
            extended_scope_review:
              type: object
              properties:
                approved_paths: { type: array, items: { type: string } }
                reason_verified: { type: boolean }
            notes: { type: string }

  seam_test:
    description: "Joint seam integration proof verifying all referenced cross-task tests passed"
    schema:
      type: object
      required: [seam_test_proof]
      properties:
        seam_test_proof:
          type: object
          required: [exit_code, seam_test_refs]
          properties:
            exit_code: { type: integer, const: 0 }
            seam_test_refs: { type: array, items: { type: string } }
            tests_passed: { type: integer }
            tests_failed: { type: integer, const: 0 }

  delivery:
    description: "Autonomous delivery receipt and atomic Git commit proof"
    schema:
      type: object
      required: [delivery_proof]
      properties:
        delivery_proof:
          type: object
          required: [delivered]
          properties:
            delivered: { type: boolean }
            commit_sha: { type: string }
            receipt_id: { type: string }

# Worker roles and recommended models
roles:
  contract_author:
    mode: subagent
    reuse_on_reject: true
    models:
      - 'sol-6.1:high'
    guidance: "As contract author, define the production-seam contract and runtime-red proof (exit code 101). For existing capabilities, extend existing domain seam tests additively and subsume weaker duplicates; author new tests only for greenfield boundaries with compiling production stubs. Post a build-targeted draft for the builder."

  builder:
    mode: subagent
    reuse_on_reject: true
    models:
      - 'gpt6-luna:xhigh'
    guidance: "Implement the approved contract inside the declared allowed_write_scope and verify tests."

  independent_reviewer:
    mode: subagent
    reuse_on_reject: true
    # Templates are returned in workflow_guidance.role_runner. Headless run
    # commands launch configured runners; manual coordinators may use the guidance.
    # The process receives the prepared prompt through an argument; stdin is closed.
    # Use an adapter that handles {session_id} when a role must resume a session.
    runner: 'codex exec -C "{worktree}" -m "{model}" -c model_reasoning_effort="{reasoning}" "{prompt}"'
    # Prompt slots also include role_guidance and goal. Omitting prompt_template
    # with a runner configured supplies a default context/scope/evidence prompt.
    prompt_template: >-
      Execute {role} for task {task_id}, stage {stage}, in {worktree}.
      Goal: {goal}. {role_guidance}
      Inspect the claimed gate context and submit evidence via task_submit.
    models:
      - 'sol-6.1:xhigh'
    guidance: "Review independently, then claim and submit delivery in the same reviewer session."

  architect:
    mode: subagent
    reuse_on_reject: true
    models:
      - 'sol-6.1:high'
    guidance: "Lead contract synthesis: inspect extension points and typed invariants, establish a compiling runtime-red seam test, and post the architectural decision with topic=decisions. Repair admitted integration findings for fresh verification and independent review."

# Scoped arguments augment the selected command for affected paths.
scope_args_by_pattern:
  "src/**/*.rs": "--lib"
  "crates/forge-core/**/*.rs": "--package forge-core --lib"
  "crates/forge-index/**/*.rs": "--package forge-index --lib"
  "crates/forge-tasks/**/*.rs": "--package forge-tasks --lib"
  "tests/acdd/**/*.rs": "--test acdd"
  "tests/mcp/**/*.rs": "--test mcp"

# Registered commands
commands:
  rust-check-and-test:
    by_pattern:
      "**/*.rs": "cargo clippy --all-targets --all-features -- -D warnings && cargo test"
    description: "Run strict Rust checks followed by the repository's test suite. Append --test <target> to focus the test command."
    timeout_seconds: 300
    output:
      counts: {passed: '(\d+) passed', failed: '(\d+) failed'}
      require_counts: true
      noise: ['^\s*(Compiling|Downloading|Finished)\b']
      errors: ['^error(\[E\d+\])?:', 'panicked at', '^FAIL ']
      seam_ref_pattern: '--test\s+([^\s]+)'
      tests:
        target: '(?m)(?:^\s*Running\s+(?:unittests\s+)?|"kind":\s*\[[^\]]*"test"[^\]]*\].*?"src_path":\s*"|--test\s+)([^\s"\\)]+)'
        passed: '(?m)^test\s+([A-Za-z0-9_:]+)\s+\.\.\.\s+ok\b'
        failed: '(?m)^test\s+([A-Za-z0-9_:]+)\s+\.\.\.\s+FAILED\b'
        ignored: '(?m)^test\s+([A-Za-z0-9_:]+)\s+\.\.\.\s+ignored\b'
  check_full_repo:
    by_pattern:
      "**/*.py": "pytest"
      "**/*.{ts,tsx,vue}": "npm test"
      "**/*.rs": "cargo test --test commitment_integrity && cargo clippy --all-targets --all-features -- -D warnings && cargo test --all-targets"
    description: "Run the milestone handoff verification commands from TESTS.md."
    timeout_seconds: 600
    output:
      counts: {passed: '(\d+) passed', failed: '(\d+) failed'}
      require_counts: true
      noise: ['^\s*(Compiling|Downloading|Finished)\b']
      errors: ['^error(\[E\d+\])?:', 'panicked at', '^FAIL ']
  lint:
    command: "cargo clippy --all-targets --all-features -- -D warnings"
    output:
      require_counts: false
      noise: ['^\s*(Checking|Compiling|Finished)\b']
      errors: ['^error(\[E\d+\])?:']
  test:
    by_pattern:
      "**/*.rs": "cargo test"
    description: "Compatibility command for legacy task evidence; workflow guidance selects rust-check-and-test."

# Central guidance catalog
guidance:
  # Navigation: code_map_query(sql="SELECT ...") or operation="sql", selector="SELECT ...".
  # Supply ast_grep_search language when path is a directory or omitted.
  # Triage with search_docs(query="...", include_excerpt=true), then get_doc(path_or_id="...", detail="compact").
  task.contract: "Define a production-seam proof and keep the task contract inside admitted scope and symbols."
  task.code: "Implement the accepted seam with the smallest change that satisfies the task contract."
  task.review: "Review the complete candidate against scope, contract, concurrency, isolation, and administration evidence."
  task.deferred_final_test: "Run the registered verification command and submit passing seam test proof."
  task.seam_review: "Review joint seam changes across interdependent tasks."

  # HITL Escalation Catalog
  hitl.careless: "HITL level CARELESS: allow autonomous contract and implementation changes; escalate only for unrecoverable infrastructure or circular milestone dependencies."
  hitl.curious: "HITL level CURIOUS: report interface evolution as telemetry; escalate breaking public APIs, irreversible storage changes, or new external dependencies."
  hitl.pro: "HITL level PRO: allow internal helpers and non-breaking implementation changes; escalate public APIs, CLI/MCP surfaces, storage schemas, and cross-milestone contracts."
  hitl.paranoic: "HITL level PARANOIC: require explicit human approval for every new symbol or signature before contract admission."

  # Subtask Definition of Done
  subtask.dod:
    description: "Definition of done for all subtasks"
    criteria:
      - "Contract slice resolution: Demonstrably resolves an explicit, bounded slice of the contract without breaking boundaries."
      - "Milestone & ADR alignment: Builds upon and strengthens existing architectural and test seams rather than authoring isolated patches or duplicate test functions."
      - "Production-seam evidence: Validates through real production paths rather than synthetic stubs mocking away system complexity."
      - "Systemic non-regression: Zero warnings/lints and complete behavioral preservation of untouched invariants."
      - "Anti-looping invariant: If an approach fails after 2 iterations, halt, post blockers to task_blackboard, retain fail-closed behavior, and escalate."

  # Review Policy
  review.policy:
    description: "Defect routing and scope boundaries for review gates"
    criteria:
      - "Route adjacent defects to their owning task or admit scope before edits; record deferred findings durably before delivery."
      - "Reviewers must accept legitimate defect fixes and verify changes against the declared scope (preventing uncontracted scope creep or overengineering)."

  # Review Focus Lenses (Cognitive Contours)
  contour.paths:
    description: "Verify changes stay within the task's admitted write perimeter and preserve protected paths."
    criteria:
      - "Compare every changed, staged, untracked, and generated file with the task's initial scope and admitted extensions."
      - "Check that profile, repository configuration, credentials, generated state, and neighboring project paths were not changed outside their explicit scope."
      - "Confirm each changed file contributes directly to an accepted invariant or seam proof."

  contour.claims:
    description: "Verify each accepted contract claim is implemented and supported by production-seam evidence."
    criteria:
      - "Trace every invariant and acceptance criterion to the production code path that enforces it."
      - "Inspect the named seam test and confirm it reaches real storage, engine, CLI, or delivery behavior rather than a substitute implementation."
      - "Check that failure cases reject malformed or missing evidence and that diagnostics identify the violated contract."

  contour.concurrency:
    description: "Verify concurrent operations cannot admit stale authority, lose receipts, or publish partial task state."
    criteria:
      - "Check transaction boundaries, revision fencing, claim ownership, and candidate baseline comparisons under competing updates."
      - "Verify rollback restores the prior task and receipt state after a failed filesystem or Git operation."
      - "Ensure lock ordering and shared-database operations cannot deadlock or cross task namespaces."

  contour.project_isolation:
    description: "Verify task data, profiles, paths, and Git operations stay within the owning workspace and project."
    criteria:
      - "Confirm workspace resolution uses the active repository root and ignores profile configuration from linked workspaces."
      - "Check task identifiers, milestone paths, database rows, and profile paths are confined to their configured repository and project."
      - "Verify symlinks, traversal segments, and malformed paths fail closed before mutation."

  contour.administration:
    description: "Verify protected configuration, migration, profile pins, and privileged delivery behavior remain governed."
    criteria:
      - "Check schema migrations are atomic, one-time, and do not alter unrelated blackboard topics or archived historical receipts."
      - "Verify profile hashes and compiled gate references fail closed on tampering or unresolved names."
      - "Confirm Git hooks run, candidate commits retain the validated parent, and receipts record the landed task SHA."

  # Milestone Operations Guidance
  milestone.synthesis: "Analyze requirements across all milestone tasks, optimize execution waves, and extract shared helpers into Wave 0."
  milestone.review: "Evaluate integrated milestone changes against milestone invariants, ADRs, and cross-task seam boundaries."
  milestone.polish: "Resolve integration failures or reviewer findings on the integrated milestone branch."
  milestone.doc: "Audit all milestone changes against documentation scope and reconcile documentation with live code and tests."
  milestone.handoff: "Terminal milestone delivery, capturing telemetry passport and archiving milestone."

# Policies catalog
policies:
  proof:
    command:
      require_zero_exit: true
      max_log_bytes: 65536
  review:
    independent_worker: true
    require_all_contours: true
  delivery:
    atomic_receipt: true
  default_review:
    independent_worker: true
    require_all_contours: true
    audit_extended_scope: true

# Reusable nested gate templates
gate_templates:
  build_review_cycle:
    gates:
      - id: "build"
        role: "builder"
        command: "check_full_repo"
        proof: "command"
      - id: "review"
        role: "independent_reviewer"
        policy: "default_review"
        proof: "review"
        contours: "guidance.contours"
        independent_from: "build"

# Hierarchical workflow: synthesize once, then execute each task's gates.
gates:
  - id: "contract_synthesis"
    role: "architect"
    guidance: [milestone.synthesis, hitl.pro]
    tools: [code_map_overview, code_map_search, code_map_inspect, code_map_impact, ast_grep_search, task_blackboard]
    steps:
      - "Inspect extension points and typed invariants within admitted scope."
      - "Post the architectural decision with topic=decisions before submitting runtime-red proof."
    proof: "contract"
    expected_failure:
      exit_codes: [1, 101, 134]
      stderr_contains: "assertion failed"
    persistence:
      pre: snapshot
      post: commit

  - tasks:
      gates:
        - id: "contract"
          role: "contract_author"
          command: "test"
          guidance: [task.contract, hitl.pro]
          proof: "contract"
          expected_failure:
            exit_codes: [1, 101, 134]
            stderr_contains: "assertion failed"
          persistence:
            post: snapshot

        - id: "build"
          role: "builder"
          guidance: [task.code, hitl.pro]
          command: "rust-check-and-test"
          proof: "command"
          persistence:
            pre: snapshot
            post: snapshot

        - id: "review"
          role: "independent_reviewer"
          guidance: [task.review, hitl.pro]
          policy: "default_review"
          proof: "review"
          contours: "guidance.contours"
          independent_from: "build"
          fail: "build"
          reject_routing:
            scope: "build"
            symbols: "contract"
          persistence:
            immutable: true

        - id: "seam"
          when: seam
          gates:
            - id: "integrate"
              role: "builder"
              command: "rust-check-and-test"
              proof: "seam_test"
              persistence:
                pre: snapshot
                post: snapshot
            - id: "review"
              role: "independent_reviewer"
              guidance: [task.seam_review, hitl.pro]
              policy: "default_review"
              proof: "review"
              contours: "guidance.contours"
              independent_from: "integrate"
              fail: "integrate"
              persistence:
                immutable: true

        - id: "deliver"
          role: "independent_reviewer"
          guidance: [hitl.pro]
          proof: "delivery"
          receipt: true
          review_sources:
            - "review"
          independent_from: "build"
          fail: "build"
          persistence:
            immutable: true
            post: commit
            git_commit_note: telemetry

  - id: "verify"
    command: "check_full_repo"
    max_attempts: 2
    pass: "documentation"
    fail: "polish"

  - id: "polish"
    role: "architect"
    guidance: [milestone.polish, hitl]
    pass: "milestone_review"
    persistence:
      pre: snapshot
      post: snapshot

  - id: "milestone_review"
    role: "independent_reviewer"
    policy: "default_review"
    guidance: [milestone.review]
    contours: "guidance.contours"
    independent_from: "polish"
    pass: "verify"
    fail: "polish"
    persistence:
      immutable: true

  - id: "documentation"
    role: "doc_writer"
    when: "doc"
    guidance: [milestone.doc]
    pass: "handoff"

  - id: "handoff"
    receipt: true
    absorb_working_tree: true
    persistence:
      post: commit
      git_commit_note: telemetry
